<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>香港旅遊行程表</title>
    <!-- Firebase Compat SDKs -->
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>
    <!-- Vue 3 -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- SortableJS for Drag and Drop -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&display=swap');
        [v-cloak] { display: none !important; }
        
        body { 
            font-family: 'Noto Sans TC', -apple-system, BlinkMacSystemFont, sans-serif; 
            background: linear-gradient(135deg, #f7f6f2 0%, #ece9e2 50%, #e1dcd3 100%);
            background-attachment: fixed;
            min-height: 100vh;
            margin: 0;
            overflow-x: hidden;
            color: #2c2a29;
        }

        .glass-panel { 
            background: rgba(255, 255, 255, 0.82); 
            backdrop-filter: blur(20px); 
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.85); 
            box-shadow: 0 12px 40px -10px rgba(40, 35, 30, 0.05);
        }
        .glass-header { 
            background: rgba(247, 246, 242, 0.75); 
            backdrop-filter: blur(20px); 
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.6); 
        }
        .glass-card { 
            background: rgba(255, 255, 255, 0.75); 
            backdrop-filter: blur(16px); 
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.8); 
            box-shadow: 0 8px 32px 0 rgba(40, 35, 30, 0.04); 
        }

        .editable-input { background: transparent; border: none; outline: none; width: 100%; }
        .sortable-ghost { opacity: 0.3; background: #e5e0d8 !important; }
        .sortable-drag { opacity: 0.9; }
        
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        .desc-text { white-space: pre-wrap; }
        .action-btn { 
            background: rgba(255,255,255,0.9); 
            border: 1px solid rgba(0,0,0,0.06); 
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); 
        }
        .action-btn:hover { 
            background: #2c2a29; 
            color: #ffffff !important;
            border-color: #2c2a29;
            transform: translateY(-1px); 
        }
        .action-btn:hover i {
            color: #ffffff !important;
        }

        .sync-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
        .sync-dot.on { background: #34d399; box-shadow: 0 0 8px rgba(52, 211, 153, 0.6); }
        .sync-dot.off { background: #f87171; }

        .day-btn-input { background: transparent; border: none; outline: none; width: 100%; text-align: center; font-weight: 600; cursor: pointer; letter-spacing: 0.05em; }
    </style>
</head>
<body>
    <div id="app" v-cloak>
        <!-- 🔐 入口頁面 -->
        <div v-if="!roomJoined" class="min-h-screen flex items-center justify-center px-6 relative z-50">
            <div class="glass-panel w-full max-w-sm rounded-[2.5rem] p-10 shadow-2xl text-center space-y-8">
                <div>
                    <div class="text-5xl mb-4 opacity-90">🏙️</div>
                    <p class="text-[11px] font-bold text-stone-500 uppercase tracking-[0.4em]">Hong Kong Trip</p>
                    <h1 class="text-3xl font-light text-stone-800 mt-2 tracking-wide">Spring <span class="italic font-serif text-stone-600">2026</span></h1>
                </div>
                <div class="space-y-3 text-left">
                    <label class="text-[10px] font-bold text-stone-400 uppercase tracking-widest ml-1">房間暗號</label>
                    <input v-model="roomInput" @keyup.enter="joinRoom" type="password" placeholder="輸入您的旅遊暗號..."
                        class="w-full bg-white/80 border border-stone-200/80 rounded-2xl py-4 px-5 text-sm focus:outline-none focus:border-stone-500 text-center tracking-widest shadow-inner">
                </div>
                <button @click="joinRoom" :disabled="!roomInput"
                    class="w-full py-4 bg-stone-900 text-stone-100 rounded-2xl text-[11px] font-bold tracking-widest uppercase disabled:opacity-20 hover:bg-stone-800 transition-all shadow-md">
                    進入行程 →
                </button>
            </div>
        </div>

        <!-- 主內容頁面 -->
        <div v-if="roomJoined" class="min-h-screen pb-20 relative z-10">
            <transition>
                <div v-if="saving" class="fixed top-6 left-1/2 -translate-x-1/2 z-[110]">
                    <div class="bg-stone-900/90 text-stone-200 px-6 py-2.5 rounded-full shadow-2xl text-[10px] font-bold tracking-widest border border-stone-700/50 flex items-center gap-3 backdrop-blur-md">
                        <i class="fa-solid fa-sync animate-spin text-amber-400"></i> SYNCING...
                    </div>
                </div>
            </transition>

            <header class="glass-header p-8 md:p-10 rounded-b-[2.5rem] sticky top-0 z-50">
                <div class="flex justify-between items-center max-w-4xl mx-auto">
                    <div class="space-y-1 flex-1 mr-4">
                        <input v-model="config.title" @change="saveToCloud" class="editable-input text-[11px] tracking-[0.35em] font-bold text-stone-500 uppercase">
                        <input v-model="config.subtitle" @change="saveToCloud" class="editable-input text-3xl md:text-4xl font-light text-stone-800 tracking-tight">
                        <div class="flex items-center gap-2 text-[11px] text-stone-500 font-medium mt-3">
                            <i class="fa-solid fa-cloud-sun text-stone-400"></i>
                            <span v-if="weather">{{ weather.desc }}: {{ weather.temp }}°C | {{ t('降雨機率') }}: {{ weather.rainChance }}%</span>
                        </div>
                    </div>
                    <div class="flex flex-col items-end gap-3">
                        <button @click="toggleLang" class="text-[10px] font-bold text-stone-500 border-b border-stone-400/60 hover:border-stone-800 px-1 py-0.5 uppercase tracking-wider transition-colors">
                            {{ lang === 'zh' ? 'English' : '中文' }}
                        </button>
                        <div class="flex items-center gap-2 bg-stone-200/50 px-3 py-1 rounded-full">
                            <span class="sync-dot" :class="saving ? 'off' : 'on'"></span>
                            <span class="text-[9px] font-bold text-stone-500 tracking-wider uppercase">{{ saving ? 'Syncing' : 'Connected' }}</span>
                        </div>
                    </div>
                </div>
            </header>

            <main class="max-w-4xl mx-auto p-4 md:p-6 mt-6 space-y-8">
                <!-- 匯率工具 (港幣 HKD 基準) -->
                <div class="glass-card p-6 rounded-[2rem]">
                    <div class="flex justify-between items-center mb-4">
                        <div class="text-stone-700 font-bold text-xs tracking-wider uppercase flex items-center gap-2">
                            <i class="fa-solid fa-coins text-amber-700"></i> {{ t('匯率試算') }}
                        </div>
                        <div class="text-[10px] font-medium text-stone-400">1 HKD = {{ rates.hkd_twd }} TWD</div>
                    </div>
                    <div class="grid grid-cols-2 gap-4 text-center">
                        <div class="bg-white/60 p-3 rounded-2xl border border-stone-200/60">
                            <label class="block text-[9px] text-stone-400 mb-1 uppercase tracking-widest font-bold">{{ t('港幣') }}</label>
                            <input v-model.number="calc.hkd" @input="convertCurrency('hkd')" type="number" class="w-full bg-transparent text-center font-semibold text-stone-800 text-lg outline-none">
                        </div>
                        <div class="bg-white/60 p-3 rounded-2xl border border-stone-200/60">
                            <label class="block text-[9px] text-stone-400 mb-1 uppercase tracking-widest font-bold">{{ t('台幣') }}</label>
                            <input v-model.number="calc.twd" @input="convertCurrency('twd')" type="number" class="w-full bg-transparent text-center font-semibold text-stone-800 text-lg outline-none">
                        </div>
                    </div>
                </div>

                <!-- 天數切換與管理 -->
                <div class="flex items-center gap-3 overflow-x-auto pb-2 no-scrollbar">
                    <div class="flex bg-white/70 backdrop-blur-md rounded-full shadow-sm p-1.5 gap-1 shrink-0 border border-stone-200/50">
                        <template v-if="config.days && config.days.length">
                            <div v-for="(day, index) in config.days" :key="day.id" class="flex items-center">
                                <div @click="currentDayId = day.id"
                                    :class="['px-5 h-10 rounded-full text-xs transition-all min-w-[90px] flex items-center justify-center cursor-pointer', currentDayId === day.id ? 'bg-stone-900 text-stone-100 shadow-md font-bold' : 'text-stone-500 hover:text-stone-800']">
                                    <input v-model="day.label" @change="saveToCloud" @click.stop 
                                        :class="['day-btn-input uppercase', currentDayId === day.id ? 'text-stone-100' : 'text-stone-500']">
                                </div>
                            </div>
                        </template>
                    </div>
                    <div class="flex gap-1.5 shrink-0">
                        <button @click="addDay" class="w-9 h-9 rounded-full bg-white/70 text-stone-600 flex items-center justify-center text-xs shadow-sm hover:bg-stone-900 hover:text-white transition-colors border border-stone-200/60">+</button>
                        <button @click="removeLastDay" v-if="config.days && config.days.length > 1" class="w-9 h-9 rounded-full bg-white/70 text-stone-400 flex items-center justify-center text-xs shadow-sm hover:text-red-500 transition-colors border border-stone-200/60">-</button>
                    </div>
                </div>

                <!-- 行程清單 -->
                <div id="sortable-events" class="space-y-5">
                    <div v-for="event in filteredEvents" :key="event.id" :data-id="event.id" class="flex gap-4 group">
                        <div class="w-12 text-[11px] font-bold text-stone-400 pt-5 text-right uppercase tracking-tighter">
                            {{ event.timeDisplay }}
                        </div>

                        <div @click="openEdit(event)" class="flex-1 glass-panel p-6 rounded-[2rem] relative cursor-pointer active:scale-[0.99] transition-all hover:shadow-lg border-l-4 border-l-stone-700">
                            <button @click.stop="removeEvent(event.id)" class="absolute top-5 right-6 text-stone-300 hover:text-red-500 transition-colors"><i class="fa-solid fa-trash text-xs"></i></button>
                            
                            <h3 class="text-base font-bold text-stone-800 mb-2 tracking-wide">{{ event.location || '未命名行程' }}</h3>
                            <div class="desc-text text-xs text-stone-500 leading-relaxed mb-4 font-normal">{{ event.desc }}</div>
                            
                            <div class="flex flex-wrap gap-2 pt-1">
                                <button v-if="event.mapUrl" @click.stop="openUrl(event.mapUrl)" class="action-btn flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[10px] font-bold text-stone-600">
                                    <i class="fa-solid fa-map-location-dot text-stone-500"></i> {{ t('地圖資訊') }}
                                </button>
                                <button v-if="event.routeA && event.routeB" @click.stop="openRoute(event.routeA, event.routeB)" class="action-btn flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[10px] font-bold text-stone-600">
                                    <i class="fa-solid fa-route text-stone-500"></i> {{ event.routeName || (event.routeA + ' ➔ ' + event.routeB) }}
                                </button>
                                <button v-if="event.videoUrl" @click.stop="openUrl(event.videoUrl)" class="action-btn flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[10px] font-bold text-stone-600">
                                    <i class="fa-solid fa-link text-stone-500"></i> {{ event.videoName || t('查看參考') }}
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <button @click="openAdd" 
                        class="w-full ml-14 py-4 border border-dashed border-stone-300/80 rounded-[1.8rem] text-stone-500 text-[11px] font-bold tracking-widest uppercase hover:bg-white/50 hover:border-stone-500 transition-all" style="width: calc(100% - 56px)">
                        + {{ t('New Entry') }}
                    </button>
                </div>
            </main>

            <!-- 編輯彈窗 -->
            <div v-if="showModal" class="fixed inset-0 z-[100] flex items-center justify-center p-6">
                <div class="absolute inset-0 bg-stone-900/40 backdrop-blur-md" @click="showModal = false"></div>
                <div class="relative bg-white/95 w-full max-w-md rounded-[2.5rem] p-8 shadow-2xl space-y-4 overflow-hidden flex flex-col max-h-[90vh] border border-stone-200">
                    <div class="text-center shrink-0 mb-1">
                        <p class="text-[11px] font-bold text-stone-500 uppercase tracking-widest">{{ editingId ? t('編輯行程') : t('New Entry') }}</p>
                    </div>
                    
                    <div class="space-y-4 overflow-y-auto pr-1 no-scrollbar flex-1 pb-2">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="text-[9px] font-bold text-stone-400 uppercase ml-1 tracking-wider">{{ t('時間') }}</label>
                                <input v-model="form.time" placeholder="09:00 (選填)" class="w-full border-b border-stone-200 py-2 text-xs focus:outline-none focus:border-stone-800 bg-transparent">
                            </div>
                            <div>
                                <label class="text-[9px] font-bold text-stone-400 uppercase ml-1 tracking-wider">{{ t('標題') }}</label>
                                <input v-model="form.location" placeholder="行程名稱" class="w-full border-b border-stone-200 py-2 text-xs focus:outline-none focus:border-stone-800 bg-transparent font-medium">
                            </div>
                        </div>
                        
                        <div class="bg-stone-100/70 p-4 rounded-2xl space-y-2.5 border border-stone-200/50">
                            <label class="text-[9px] font-bold text-stone-600 uppercase tracking-wider flex items-center gap-2">
                                <i class="fa-solid fa-map-signs text-stone-500"></i> 路線規劃 (選填)
                            </label>
                            <div class="flex items-center gap-2">
                                <input v-model="form.routeA" placeholder="起點" class="flex-1 bg-white border border-stone-200 rounded-lg px-3 py-1.5 text-xs focus:outline-none">
                                <span class="text-stone-400 text-xs">➔</span>
                                <input v-model="form.routeB" placeholder="終點" class="flex-1 bg-white border border-stone-200 rounded-lg px-3 py-1.5 text-xs focus:outline-none">
                            </div>
                            <input v-model="form.routeName" placeholder="按鈕顯示名稱" class="w-full bg-white border border-stone-200 rounded-lg px-3 py-1.5 text-xs focus:outline-none">
                        </div>

                        <div class="space-y-2 bg-stone-100/70 p-4 rounded-2xl border border-stone-200/50">
                            <label class="text-[9px] font-bold text-stone-600 uppercase tracking-wider flex items-center gap-2">
                                <i class="fa-solid fa-link text-stone-500"></i> 連結 (Reels / Blog)
                            </label>
                            <input v-model="form.videoUrl" placeholder="貼上網址" class="w-full border-b border-stone-200 py-1 text-xs focus:outline-none bg-transparent">
                            <input v-model="form.videoName" placeholder="顯示名稱" class="w-full border-b border-stone-200 py-1 text-xs focus:outline-none italic opacity-70 bg-transparent">
                        </div>

                        <div>
                            <label class="text-[9px] font-bold text-stone-400 uppercase ml-1 tracking-wider">{{ t('地圖資訊') }}</label>
                            <input v-model="form.mapUrl" placeholder="Google 地圖網址" class="w-full border-b border-stone-200 py-2 text-xs focus:outline-none focus:border-stone-800 bg-transparent">
                        </div>

                        <div>
                            <label class="text-[9px] font-bold text-stone-400 uppercase ml-1 tracking-wider">{{ t('內容') }}</label>
                            <textarea v-model="form.desc" placeholder="想記下的東西..." class="w-full border-b border-stone-200 py-2 text-xs focus:outline-none resize-none h-28 focus:border-stone-800 bg-transparent"></textarea>
                        </div>
                    </div>

                    <button @click="saveEvent" :disabled="!form.location"
                        class="w-full py-4 bg-stone-900 text-stone-100 rounded-2xl text-[11px] font-bold tracking-widest uppercase disabled:opacity-20 shadow-lg shrink-0 active:scale-95 transition-all">
                        確認儲存
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const { createApp, ref, computed, onMounted, nextTick } = Vue;

        const firebaseConfig = {
            apiKey: "", 
            authDomain: "sakura-db2eb.firebaseapp.com",
            databaseURL: "https://sakura-db2eb-default-rtdb.asia-southeast1.firebasedatabase.app",
            projectId: "sakura-db2eb",
            appId: "1:1018635903034:web:b9cff8697598f66be55503"
        };

        if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
        const db = firebase.database();

        createApp({
            setup() {
                const roomJoined = ref(false);
                const roomInput = ref('');
                const roomKey = ref('');
                const saving = ref(false);
                const currentDayId = ref('d1');
                const lang = ref('zh');
                const weather = ref({ temp: '--', desc: 'Hong Kong', rainChance: '--' });
                const showModal = ref(false);
                const editingId = ref(null);
                let sortableInstance = null;
                let dbRef = null;

                const config = ref({ 
                    title: 'HONG KONG ADVENTURE', 
                    subtitle: 'Hong Kong 2026',
                    days: [{ id: 'd1', label: 'DAY 1' }]
                });

                const events = ref([]);
                const form = ref({ time: '', location: '', desc: '', mapUrl: '', videoUrl: '', videoName: '', routeA: '', routeB: '', routeName: '' });
                const calc = ref({ hkd: 0, twd: 0 });
                const rates = ref({ hkd_twd: 4.15 });

                const joinRoom = () => {
                    if (!roomInput.value.trim()) return;
                    roomKey.value = `room_${roomInput.value.trim()}`;
                    roomJoined.value = true;
                    startSync();
                    fetchWeather();
                    fetchRates();
                };

                const startSync = () => {
                    dbRef = db.ref(`rooms/${roomKey.value}`);
                    dbRef.on('value', (snapshot) => {
                        const data = snapshot.val();
                        if (data) {
                            events.value = data.events ? Object.values(data.events) : [];
                            if (data.config) {
                                config.value = data.config;
                                if (config.value.days && !config.value.days.find(d => d.id === currentDayId.value)) {
                                    currentDayId.value = config.value.days[0].id;
                                }
                            }
                        }
                        nextTick(() => initSortable());
                    });
                };

                const saveToCloud = async () => {
                    if (!dbRef) return;
                    saving.value = true;
                    const eventsObj = {};
                    events.value.forEach(e => { eventsObj[e.id] = e; });
                    try {
                        await dbRef.set({ events: eventsObj, config: config.value });
                        setTimeout(() => saving.value = false, 400);
                    } catch (e) { 
                        console.error('Save error:', e);
                        saving.value = false; 
                    }
                };

                const toggleLang = () => { lang.value = lang.value === 'zh' ? 'en' : 'zh'; };

                const t = (text) => {
                    const d = { 
                        '降雨機率': { en: 'Rain %' }, 
                        '匯率試算': { en: 'Currency' }, 
                        'New Entry': { en: 'Add Event' }, 
                        '編輯行程': { en: 'Edit Entry' }, 
                        '地圖資訊': { en: 'Map' }, 
                        '查看參考': { en: 'Link' }, 
                        '標題': { en: 'Title' }, 
                        '內容': { en: 'Notes' }, 
                        '港幣': { en: 'HKD' }, 
                        '台幣': { en: 'TWD' }, 
                        '時間': { en: 'Time' } 
                    };
                    return lang.value === 'zh' ? text : (d[text]?.en || text);
                };

                const filteredEvents = computed(() => {
                    if (!events.value) return [];
                    return events.value
                        .filter(e => e.dayId === currentDayId.value)
                        .map(e => ({
                            ...e,
                            timeDisplay: (e.time && e.time !== '待定') ? e.time : ''
                        }))
                        .sort((a, b) => {
                            if (a.customOrder !== undefined && b.customOrder !== undefined && a.customOrder !== null && b.customOrder !== null) {
                                return a.customOrder - b.customOrder;
                            }
                            const timeA = (a.timeDisplay || 'zz:zz');
                            const timeB = (b.timeDisplay || 'zz:zz');
                            return timeA.localeCompare(timeB);
                        });
                });

                const initSortable = () => {
                    const el = document.getElementById('sortable-events');
                    if (!el) return;
                    if (sortableInstance) sortableInstance.destroy();

                    sortableInstance = Sortable.create(el, {
                        animation: 150,
                        ghostClass: 'sortable-ghost',
                        dragClass: 'sortable-drag',
                        onEnd: () => {
                            const sortedIds = Array.from(el.querySelectorAll('[data-id]')).map(item => item.getAttribute('data-id'));
                            events.value.forEach(ev => {
                                const newIdx = sortedIds.indexOf(ev.id);
                                if (newIdx !== -1) {
                                    ev.customOrder = newIdx;
                                }
                            });
                            saveToCloud();
                        }
                    });
                };

                // Open-Meteo Weather API for Hong Kong (Lat: 22.3193, Lon: 114.1694)
                const fetchWeather = async () => {
                    try {
                        const res = await fetch('https://api.open-meteo.com/v1/forecast?latitude=22.3193&longitude=114.1694&current_weather=true&daily=precipitation_probability_max&timezone=Asia%2FHong_Kong');
                        const data = await res.json();
                        weather.value = { 
                            temp: Math.round(data.current_weather.temperature), 
                            desc: 'Hong Kong', 
                            rainChance: data.daily?.precipitation_probability_max?.[0] || 0 
                        };
                    } catch (e) { console.error('Weather error:', e); }
                };

                // Exchange Rates API for HKD
                const fetchRates = async () => {
                    try {
                        const res = await fetch('https://open.er-api.com/v6/latest/HKD');
                        const data = await res.json();
                        if (data.rates) {
                            rates.value.hkd_twd = data.rates.TWD.toFixed(2);
                        }
                    } catch (e) { console.error('Exchange rates error:', e); }
                };

                const saveEvent = async () => {
                    const timeVal = (form.value.time && form.value.time !== '待定') ? form.value.time : '';
                    const eventData = {
                        id: editingId.value || Date.now().toString(),
                        dayId: currentDayId.value,
                        ...form.value,
                        time: timeVal,
                        customOrder: editingId.value ? (events.value.find(e => e.id === editingId.value)?.customOrder) : events.value.length
                    };
                    
                    if (editingId.value) {
                        const idx = events.value.findIndex(e => e.id === editingId.value);
                        if (idx !== -1) events.value[idx] = eventData;
                    } else {
                        events.value.push(eventData);
                    }
                    await saveToCloud();
                    showModal.value = false;
                };

                const openEdit = (event) => {
                    editingId.value = event.id;
                    const timeToEdit = (event.time && event.time !== '待定') ? event.time : '';
                    form.value = { ...event, time: timeToEdit, routeName: event.routeName || '', videoName: event.videoName || '' };
                    showModal.value = true;
                };

                const removeEvent = (id) => { 
                    events.value = events.value.filter(e => e.id !== id); 
                    saveToCloud(); 
                };

                const addDay = () => { 
                    if (!config.value.days) config.value.days = [];
                    config.value.days.push({ 
                        id: 'd' + Date.now(), 
                        label: 'DAY ' + (config.value.days.length + 1) 
                    }); 
                    saveToCloud(); 
                };

                const removeLastDay = () => { 
                    if(config.value.days.length > 1) { 
                        const removed = config.value.days.pop();
                        events.value = events.value.filter(e => e.dayId !== removed.id);
                        if (currentDayId.value === removed.id) currentDayId.value = config.value.days[0].id;
                        saveToCloud(); 
                    } 
                };

                const openUrl = (url) => { if (url) window.open(url.startsWith('http') ? url : 'https://' + url, '_blank'); };
                const openRoute = (a, b) => { window.open(`https://www.google.com/maps/dir/${encodeURIComponent(a)}/${encodeURIComponent(b)}`, '_blank'); };

                // Currency Converter Logic for HKD / TWD
                const convertCurrency = (base) => {
                    const val = calc.value[base] || 0;
                    if (base === 'hkd') { 
                        calc.value.twd = Math.round(val * rates.value.hkd_twd); 
                    }
                    else if (base === 'twd') { 
                        const hkd = val / rates.value.hkd_twd; 
                        calc.value.hkd = Math.round(hkd); 
                    }
                };

                return { 
                    roomJoined, roomInput, saving, config, events, filteredEvents, currentDayId, showModal, editingId, lang, weather, calc, rates, form, 
                    joinRoom, toggleLang, t, saveToCloud, addDay, removeLastDay, openUrl, openRoute,
                    openAdd: () => { editingId.value = null; form.value = { time: '', location: '', desc: '', mapUrl: '', videoUrl: '', videoName: '', routeA: '', routeB: '', routeName: '' }; showModal.value = true; },
                    openEdit, saveEvent, removeEvent, convertCurrency 
                };
            }
        }).mount('#app');
    </script>
</body>
</html>
